# Orbit configuration - copy to `.env` and fill in your own values.
# `.env` is gitignored; never commit real secrets.

# --- AI model ---------------------------------------------------------------
# Set a key to enable full LLM features (recommended - fast and reliable).
ANTHROPIC_API_KEY=
# Optionally force a specific byLLM model (overrides the auto choice):
# ORBIT_MODEL=anthropic/claude-sonnet-4-6
#
# With NO key, Orbit uses only its deterministic logic by default (stable, never
# crashes). The local model is powerful but its CPU backend can be unstable, so
# it is opt-in. To use it (after: jac install 'byllm[local]' && jac model pull
# gemma-4-e4b), uncomment the next line:
# ORBIT_LOCAL_AI=1

# --- Google Calendar (read-only) -------------------------------------------
# For each calendar: Google Calendar > Settings > <calendar> > Integrate
# calendar > "Secret address in iCal format" (ends in /basic.ics).
#
# One calendar:
ORBIT_CAL_ICS_URL=
ORBIT_CAL_AREA=other
#
# Multiple color-coded calendars -> map each feed to its own Orbit area, as
# `area|url` entries separated by semicolons (make the areas first in Settings,
# then set their colors to match your Google colors):
# ORBIT_CAL_ICS_URLS=fitness|https://calendar.google.com/.../gym/basic.ics;clubs|https://calendar.google.com/.../clubs/basic.ics;research|https://calendar.google.com/.../research/basic.ics
ORBIT_CAL_ICS_URLS=

# --- Notion (a database OR a plain checklist page) --------------------------
# 1. Create an internal integration at https://www.notion.so/my-integrations
#    and copy its "Internal Integration Secret" -> NOTION_TOKEN.
# 2. Share the page/database with the integration: open it > "..." menu >
#    Connections > add your integration (without this the API 404s).
# 3. Set EITHER of the following (page takes priority if both are set):
#
# (a) A plain page that is just a to-do checklist. Its id is the 32-char hex at
#     the end of the page URL: notion.so/<workspace>/<Title>-<PAGE_ID>
#     Unchecked items (including nested ones) import as tasks.
NOTION_PAGE_ID=
#
# (b) A database (table/board). Its id is the 32-char hex BEFORE the "?v=":
#     notion.so/<workspace>/<DATABASE_ID>?v=<view_id>
NOTION_DB_ID=
# Column names, only for the database case (defaults shown):
ORBIT_NOTION_TITLE_PROP=Name
ORBIT_NOTION_DATE_PROP=Due

NOTION_TOKEN=
ORBIT_NOTION_AREA=coursework

# --- Slack ------------------------------------------------------------------
# Creating a Slack app at api.slack.com/apps is personal and does NOT affect the
# whole workspace - installing it just needs the workspace to allow it (some
# orgs, incl. universities, require an admin to approve). Add USER token scopes
# `channels:history` (public) + `groups:history` (private channels you're in);
# the token only reads what you can already see. List channel IDs in
# SLACK_CHANNELS (open a channel > "..." > View channel details, id at bottom).
SLACK_CHANNELS=
ORBIT_SLACK_AREA=research
#
# Auth - use ONE of these:
# (a) A non-rotating token: paste the User OAuth Token (xoxp-...).
SLACK_TOKEN=
# (b) Token rotation (12h access token + refresh token): give the app's
#     Client ID/Secret (Basic Information) and your CURRENT refresh token
#     (xoxe-...). Orbit refreshes and rotates it automatically after that; the
#     value below is only the initial seed and goes stale once it first rotates.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REFRESH_TOKEN=
