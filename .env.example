# Copy to `.env` and fill in. `.env` is gitignored - never commit secrets.

# AI is on by default. With a key it uses the cloud (fast, stable); with no key
# it uses the bundled local model (Qwen). Every AI feature falls back to
# deterministic logic, so nothing ever breaks.
ANTHROPIC_API_KEY=
# ORBIT_MODEL=anthropic/claude-sonnet-4-6   # override the auto model choice
# ORBIT_AI_OFF=1     # force deterministic-only (if the local model is unstable)

# Google Calendar (read-only): the "Secret address in iCal format" URL.
# One feed:
ORBIT_CAL_ICS_URL=
ORBIT_CAL_AREA=other
# Or several color-coded feeds as `area|url` pairs separated by `;`
# (use area `auto` to infer each event's area from its title):
ORBIT_CAL_ICS_URLS=

# Notion: create an integration, copy its secret to NOTION_TOKEN, and share
# the page/database with it. Set a checklist page id OR a database id.
NOTION_PAGE_ID=
NOTION_DB_ID=
ORBIT_NOTION_TITLE_PROP=Name
ORBIT_NOTION_DATE_PROP=Due
NOTION_TOKEN=
ORBIT_NOTION_AREA=coursework
