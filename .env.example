# Orbit configuration - copy to `.env` and fill in your own values.
# `.env` is gitignored; never commit real secrets.

# --- AI model ---------------------------------------------------------------
# Set a key to enable full LLM features (recommended - fast and reliable).
ANTHROPIC_API_KEY=
# Optionally force a specific byLLM model (overrides the auto choice):
# ORBIT_MODEL=anthropic/claude-sonnet-4-6
#
# With NO key, Orbit uses only its deterministic logic by default (stable, never
# crashes). The local model is powerful but its CPU backend can be unstable, so
# it is opt-in. To use it (after: jac install 'byllm[local]' && jac model pull
# gemma-4-e4b), uncomment the next line:
# ORBIT_LOCAL_AI=1

# --- Google Calendar (read-only) -------------------------------------------
# In Google Calendar: Settings > your calendar > "Secret address in iCal format".
ORBIT_CAL_ICS_URL=
# Which Orbit area imported events land in (default: other):
ORBIT_CAL_AREA=other

# --- Notion to-do database --------------------------------------------------
# Create an internal integration at https://www.notion.so/my-integrations,
# share your database with it, and copy the token + database id.
NOTION_TOKEN=
NOTION_DB_ID=
ORBIT_NOTION_AREA=coursework
# Property names in your database (defaults shown):
ORBIT_NOTION_TITLE_PROP=Name
ORBIT_NOTION_DATE_PROP=Due

# --- Slack ------------------------------------------------------------------
# A user or bot token with channels:history + a comma-separated list of
# channel IDs to read (e.g. C0123ABC,C0456DEF).
SLACK_TOKEN=
SLACK_CHANNELS=
ORBIT_SLACK_AREA=research
