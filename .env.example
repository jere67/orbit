# Orbit configuration - copy to `.env` and fill in your own values.
# `.env` is gitignored; never commit real secrets.

# --- AI model ---------------------------------------------------------------
# Set a key to enable full LLM features (recommended - fast and reliable).
ANTHROPIC_API_KEY=
# Optionally force a specific byLLM model (overrides the auto choice):
# ORBIT_MODEL=anthropic/claude-sonnet-4-6
#
# With NO key, Orbit uses only its deterministic logic by default (stable, never
# crashes). The local model is powerful but its CPU backend can be unstable, so
# it is opt-in. To use it (after: jac install 'byllm[local]' && jac model pull
# gemma-4-e4b), uncomment the next line:
# ORBIT_LOCAL_AI=1

# --- Google Calendar (read-only) -------------------------------------------
# For each calendar: Google Calendar > Settings > <calendar> > Integrate
# calendar > "Secret address in iCal format" (ends in /basic.ics).
#
# One calendar:
ORBIT_CAL_ICS_URL=
ORBIT_CAL_AREA=other
#
# Multiple color-coded calendars -> map each feed to its own Orbit area, as
# `area|url` entries separated by semicolons (make the areas first in Settings,
# then set their colors to match your Google colors):
# ORBIT_CAL_ICS_URLS=fitness|https://calendar.google.com/.../gym/basic.ics;clubs|https://calendar.google.com/.../clubs/basic.ics;research|https://calendar.google.com/.../research/basic.ics
ORBIT_CAL_ICS_URLS=

# --- Notion to-do database --------------------------------------------------
# 1. Create an internal integration at https://www.notion.so/my-integrations
#    and copy its "Internal Integration Secret" -> NOTION_TOKEN.
# 2. Your tasks must live in a DATABASE (a table/board), not a plain page.
# 3. Open that database as a full page. The DB id is the 32-char hex string in
#    the URL BEFORE the "?v=":  notion.so/<workspace>/<DATABASE_ID>?v=<view_id>
# 4. In the database's "..." menu > Connections > add your integration (without
#    this the API returns nothing / 404).
NOTION_TOKEN=
NOTION_DB_ID=
ORBIT_NOTION_AREA=coursework
# Property names in your database (defaults shown):
ORBIT_NOTION_TITLE_PROP=Name
ORBIT_NOTION_DATE_PROP=Due

# --- Slack ------------------------------------------------------------------
# Creating a Slack app at api.slack.com/apps is personal and does NOT affect the
# whole workspace - installing it just needs the workspace to allow it (some
# orgs, incl. universities, require an admin to approve). Use a USER token
# (xoxp-...) with `channels:history` (public) and `groups:history` (private
# channels you're in); it can only read what you can already see. Then list the
# channel IDs (open a channel > "..." > View channel details, id at the bottom).
SLACK_TOKEN=
SLACK_CHANNELS=
ORBIT_SLACK_AREA=research
